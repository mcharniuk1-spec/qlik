index 0000000..e88c8a6
--- /dev/null
+++ b/src/export.mjs
@@ -0,0 +1,58 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+
+export async function exportViz(page, { vizId, outDir, fileBase, format = "CSV_C" } = {}) {
+  if (!vizId) throw new Error("vizId is required");
+  if (!outDir) throw new Error("outDir is required");
+  if (!fileBase) throw new Error("fileBase is required");
+
+  await fs.mkdir(outDir, { recursive: true });
+
+  const exportInfo = await page.evaluate(async ({ vizId, format }) => {
+    const req = window.requirejs || window.require;
+    const qlik = await new Promise((resolve, reject) => req(["js/qlik"], resolve, reject));
+    const app = qlik.currApp();
+    if (!app) throw new Error("No app");
+
+    const v = await app.visualization.get(vizId);
+    const res = await v.exportData({ format });
+    return res;
+  }, { vizId, format });
+
+  const qUrl = exportInfo?.qUrl;
+  if (!qUrl) throw new Error("exportData returned no qUrl. Export may be disabled or vizId incorrect.");
+
+  const absUrl = new URL(qUrl, page.url()).toString();
+  const resp = await page.request.get(absUrl);
+  if (!resp.ok()) throw new Error(`Download failed: ${resp.status()} ${resp.statusText()}`);
+
+  const ext = format === "OOXML" ? "xlsx" : "csv";
+  const outPath = path.join(outDir, `${fileBase}.${ext}`);
+  await fs.writeFile(outPath, await resp.body());
+
+  return { outPath, absUrl, exportInfo };
+}
diff --git a/src/partition.mjs b/src/partition.mjs
new file mode 100644
index 0000000..509e8e5
--- /dev/null
+++ b/src/partition.mjs
@@ -0,0 +1,31 @@
+export async function exportByYears(page, { yearField, years, exportFn } = {}) {
+  if (!yearField) throw new Error("yearField is required");
+  if (!Array.isArray(years) || !years.length) throw new Error("years[] is required");
+  if (typeof exportFn !== "function") throw new Error("exportFn is required");
+
+  const results = [];
+  for (const y of years) {
+    await page.evaluate(async ({ yearField, y }) => {
+      const req = window.requirejs || window.require;
+      const qlik = await new Promise((resolve, reject) => req(["js/qlik"], resolve, reject));
+      const app = qlik.currApp();
+      if (!app) throw new Error("No app");
+      await app.field(yearField).selectValues([{ qText: String(y) }], false, true);
+    }, { yearField, y });
+
+    const r = await exportFn(y);
+    results.push(r);
+  }
+  return results;
+}
diff --git a/src/select.mjs b/src/select.mjs
new file mode 100644
index 0000000..b82b7a8
--- /dev/null
+++ b/src/select.mjs
@@ -0,0 +1,56 @@
+export async function applyMilkFilter(page, { fieldCpv, fieldItemName, milkCodes = [], keywords = ["молоко", "milk"] } = {}) {
+  return await page.evaluate(async ({ fieldCpv, fieldItemName, milkCodes, keywords }) => {
+    const req = window.requirejs || window.require;
+    const qlik = await new Promise((resolve, reject) => req(["js/qlik"], resolve, reject));
+    const app = qlik.currApp();
+    if (!app) throw new Error("No app");
+
+    try { await app.clearAll(); } catch {}
+
+    if (fieldCpv && milkCodes.length) {
+      const f = app.field(fieldCpv);
+      await f.selectMatch(milkCodes.join("|"), true);
+      return { ok: true, method: "cpv", fieldCpv, milkCodes };
+    }
+
+    if (fieldItemName) {
+      const f = app.field(fieldItemName);
+      const pattern = keywords.map(k => `*${k}*`).join("|");
+      await f.selectMatch(pattern, true);
+      return { ok: true, method: "name", fieldItemName, pattern };
+    }
+
+    return { ok: false, error: "No usable field provided. Set FIELD_CPV or FIELD_ITEM_NAME in .env" };
+  }, { fieldCpv, fieldItemName, milkCodes, keywords });
+}
