@@ -0,0 +1,83 @@
+import "dotenv/config";
+import { launchBrowser, openBI } from "../src/browser.mjs";
+import { applyMilkFilter } from "../src/select.mjs";
+import { exportViz } from "../src/export.mjs";
+import { exportByYears } from "../src/partition.mjs";
+
+const url = process.env.BI_URL;
+const headless = (process.env.HEADLESS || "true") === "true";
+const vizId = process.env.TABLE_VIZ_ID;
+const outDir = process.env.OUT_DIR || "./out";
+const exportFormat = process.env.EXPORT_FORMAT || "CSV_C";
+
+const fieldCpv = (process.env.FIELD_CPV || "").trim();
+const fieldItemName = (process.env.FIELD_ITEM_NAME || "").trim();
+const fieldYear = (process.env.FIELD_DATE_YEAR || "").trim();
+
+const milkCodes = (process.env.MILK_CODES || "")
+  .split(",")
+  .map((s) => s.trim())
+  .filter(Boolean);
+
+const milkKeywords = (process.env.MILK_KEYWORDS || "")
+  .split(",")
+  .map((s) => s.trim())
+  .filter(Boolean);
+
+const startYear = Number(process.env.START_YEAR || "2015");
+
+if (!url) throw new Error("BI_URL is required");
+if (!vizId) throw new Error("TABLE_VIZ_ID is required (run: npm run discover)");
+if (!fieldYear) throw new Error("FIELD_DATE_YEAR is required for full export by years");
+
+const { browser, page } = await launchBrowser({ headless });
+await openBI(page, url);
+
+// 1) Фільтр “молоко”
+const filterRes = await applyMilkFilter(page, {
+  fieldCpv,
+  fieldItemName,
+  milkCodes,
+  keywords: milkKeywords.length ? milkKeywords : ["молоко", "milk", "пастер", "ультрапастер", "uht"],
+});
+console.log("Milk filter:", filterRes);
+
+// 2) Роки
+const currentYear = new Date().getFullYear();
+const years = [];
+for (let y = startYear; y <= currentYear; y++) years.push(y);
+
+// 3) Експорт по роках
+const results = await exportByYears(page, {
+  yearField: fieldYear,
+  years,
+  exportFn: async (y) => {
+    return await exportViz(page, {
+      vizId,
+      outDir,
+      fileBase: `prozorro_milk_${y}`,
+      format: exportFormat,
+    });
+  },
+});
+
+console.log("Done. Files:");
+for (const r of results) console.log(" -", r.outPath);
+
+await browser.close();
diff --git a/scripts/03_to_xlsx.mjs b/scripts/03_to_xlsx.mjs
