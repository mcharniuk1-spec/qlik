@@ -0,0 +1,69 @@
+export async function discoverSheetVisualizations(page) {
+  return await page.evaluate(async () => {
+    const req = window.requirejs || window.require;
+    if (!req) throw new Error("No requirejs/require found on page. Qlik may not be loaded yet.");
+
+    const qlik = await new Promise((resolve, reject) => {
+      req(["js/qlik"], resolve, reject);
+    });
+
+    const app = qlik.currApp();
+    if (!app) throw new Error("Cannot get current app via qlik.currApp()");
+
+    const sheetId = window.location.pathname.split("/sheet/")[1]?.split("/")[0];
+    if (!sheetId) throw new Error("Cannot parse sheetId from URL");
+
+    const sheet = await app.getObject(sheetId);
+    const layout = await sheet.getLayout();
+
+    // У різних версіях layout може містити cells або qChildList.qItems
+    const items = layout?.cells || layout?.qChildList?.qItems || [];
+
+    const out = [];
+    for (const it of items) {
+      const id =
+        it?.name || it?.qInfo?.qId || it?.qId || it?.qObject?.qInfo?.qId;
+      if (!id) continue;
+
+      try {
+        const v = await app.visualization.get(id);
+        const vLayout = await v.model.getLayout();
+        out.push({
+          id,
+          type: vLayout?.visualization || vLayout?.qInfo?.qType || "unknown",
+          title: vLayout?.title || vLayout?.qMeta?.title || "",
+        });
+      } catch (e) {
+        out.push({
+          id,
+          type: "unknown",
+          title: "",
+          error: String(e),
+        });
+      }
+    }
+
+    return {
+      sheetId,
+      count: out.length,
+      visuals: out,
+    };
+  });
+}
