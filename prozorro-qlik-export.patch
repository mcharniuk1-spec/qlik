+# ============================
+# BI.Prozorro (Qlik Sense) URL
+# ============================
+# Приклад:
+# https://bi.prozorro.org/sense/app/<APP_ID>/sheet/<SHEET_ID>/state/analysis
+BI_URL="https://bi.prozorro.org/sense/app/<APP_ID>/sheet/<SHEET_ID>/state/analysis"
+
+# ============================
+# Після npm run discover:
+# ============================
+# ID таблиці/візуалізації, яку треба експортувати (об’єкт на sheet)
+TABLE_VIZ_ID=""
+
+# ============================
+# Назви полів Qlik (реальні назви ви подивитесь через docs/USAGE.md)
+# ============================
+# Поле CPV/DK (краще за все)
+FIELD_CPV=""
+
+# Поле назви позиції/номенклатури (fallback, якщо CPV немає)
+FIELD_ITEM_NAME=""
+
+# Поле року (для розбиття експорту на пакети)
+FIELD_DATE_YEAR=""
+
+# ============================
+# Фільтри “молоко”
+# ============================
+# Базові CPV (можете доповнювати)
+MILK_CODES="15510000-6,15511000-3"
+
+# Якщо ви фільтруєте по назві (коли CPV відсутній)
+MILK_KEYWORDS="молоко,milk,пастер,ультрапастер,UHT"
+
+# ============================
+# Вивід
+# ============================
+OUT_DIR="./out"
+
+# true = headless, false = показувати браузер (інколи Qlik краще працює не-headless)
+HEADLESS="true"
+
+# Формат експорту: CSV_C (comma), CSV_T (tab), OOXML (xlsx, якщо підтримується)
+EXPORT_FORMAT="CSV_C"
+
+# Рік старту для повного експорту (потрібен, якщо ви не хочете руками задавати список років)
+START_YEAR="2015"
