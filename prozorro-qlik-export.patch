+// Не обов’язково для основного флоу, але корисно як “перевірка, що qlik піднявся”.
+export async function checkQlikAvailable(page) {
+  return await page.evaluate(async () => {
+    const req = window.requirejs || window.require;
+    if (!req) return { ok: false, reason: "no requirejs/require" };
+
+    const qlik = await new Promise((resolve, reject) => {
+      req(["js/qlik"], resolve, reject);
+    });
+
+    const app = qlik.currApp?.();
+    return { ok: true, hasApp: !!app };
+  });
+}
