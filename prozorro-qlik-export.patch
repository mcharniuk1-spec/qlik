@@ -0,0 +1,58 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+
+export async function exportViz(
+  page,
+  { vizId, outDir, fileBase, format = "CSV_C" } = {}
+) {
+  if (!vizId) throw new Error("vizId is required");
+  if (!outDir) throw new Error("outDir is required");
+  if (!fileBase) throw new Error("fileBase is required");
+
+  await fs.mkdir(outDir, { recursive: true });
+
+  const exportInfo = await page.evaluate(async ({ vizId, format }) => {
+    const req = window.requirejs || window.require;
+    const qlik = await new Promise((resolve, reject) => req(["js/qlik"], resolve, reject));
+    const app = qlik.currApp();
+    if (!app) throw new Error("No app");
+
+    const v = await app.visualization.get(vizId);
+    const res = await v.exportData({ format });
+    return res;
+  }, { vizId, format });
+
+  const qUrl = exportInfo?.qUrl;
+  if (!qUrl) {
+    throw new Error(
+      "exportData returned no qUrl. Export may be disabled, or vizId is incorrect."
+    );
+  }
+
+  const absUrl = new URL(qUrl, page.url()).toString();
+  const resp = await page.request.get(absUrl);
+  if (!resp.ok()) throw new Error(`Download failed: ${resp.status()} ${resp.statusText()}`);
+
+  const ext = format === "OOXML" ? "xlsx" : "csv";
+  const outPath = path.join(outDir, `${fileBase}.${ext}`);
+  await fs.writeFile(outPath, await resp.body());
+
+  return { outPath, absUrl, exportInfo };
+}
diff --git a/src/partition.mjs b/src/partition.mjs
