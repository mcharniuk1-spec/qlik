+import "dotenv/config";
+import { launchBrowser, openBI } from "../src/browser.mjs";
+import { discoverSheetVisualizations } from "../src/discover.mjs";
+
+const url = process.env.BI_URL;
+const headless = (process.env.HEADLESS || "true") === "true";
+
+if (!url) {
+  throw new Error("BI_URL is required in .env");
+}
+
+const { browser, page } = await launchBrowser({ headless });
+await openBI(page, url);
+
+const res = await discoverSheetVisualizations(page);
+console.log(JSON.stringify(res, null, 2));
+
+await browser.close();
diff --git a/scripts/02_export_milk_all.mjs b/scripts/02_export_milk_all.mjs
